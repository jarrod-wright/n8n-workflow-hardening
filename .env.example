# ---------------------------------------------------------------------------
# Example environment file. Copy to .env and set real values locally.
#   cp .env.example .env
# .env is git-ignored. This file carries PLACEHOLDERS ONLY — never a real
# secret and never a plausible-looking default. Replace every CHANGE_ME_*.
#
# HOW THESE VALUES REACH THE CONTAINERS
# .env is the single file you edit, but it is NOT handed to every service.
# `npm run stack:up` first runs tools/materialise-secrets.mjs, which derives a
# scoped delivery surface from this file into deployment/secrets/ (git-ignored):
#
#   * postgres and valkey read .env directly — the passwords in it are theirs.
#   * the two n8n services get ONLY deployment/secrets/n8n.env, which carries
#     exactly one secret (ORDER_INTAKE_HMAC_SECRET) plus non-secret config.
#   * N8N_ENCRYPTION_KEY, DB_POSTGRESDB_PASSWORD and QUEUE_BULL_REDIS_PASSWORD
#     are written as individual secret files and delivered to n8n by their
#     `_FILE` form, so their values never enter the n8n process environment.
#
# Why it matters: n8n Code nodes cannot read credentials, so
# N8N_BLOCK_ENV_ACCESS_IN_NODE must stay `false` and any Code node can read the
# whole process environment. Scoping delivery is what keeps that blast radius at
# exactly one secret. tests/env-secret-surface.test.js fails the build if a
# second one ever appears. See deployment/README.md.
# ---------------------------------------------------------------------------

# --- Postgres (n8n data store + idempotency/dead-letter tables) ---
POSTGRES_USER=n8n
POSTGRES_DB=n8n
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# n8n reaches Postgres over its own DB_POSTGRESDB_* variable names, never
# Compose `${...}` interpolation, so no secret is baked into the compose model.
# Each MUST equal its POSTGRES_* counterpart above (a mismatch is caught by the
# env-consistency test and would otherwise fail silently at DB-connect time).
# DB_POSTGRESDB_PASSWORD is delivered to n8n as a secret FILE, not as an
# environment value — see the header note.
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# --- Valkey broker (queue mode) ---
# requirepass value. The broker port is NOT published to the host; the broker
# is reachable only on the internal compose network, and only with this value.
VALKEY_PASSWORD=CHANGE_ME_VALKEY_PASSWORD

# n8n reaches the broker over the Redis-protocol variables. This MUST equal
# VALKEY_PASSWORD (same secret, referenced from n8n's side). Delivered to n8n as
# a secret FILE, not as an environment value — see the header note.
QUEUE_BULL_REDIS_PASSWORD=CHANGE_ME_VALKEY_PASSWORD

# --- n8n ---
# 32+ char key used to encrypt stored credentials. Delivered to n8n as a secret
# FILE, not as an environment value.
#
# Keep it stable across restarts, and back it up: n8n encrypts every stored
# credential with this key, so losing it makes every stored credential
# permanently undecryptable. There is no recovery path — the credentials must be
# deleted and re-entered by hand.
N8N_ENCRYPTION_KEY=CHANGE_ME_N8N_ENCRYPTION_KEY
# Public API key, referenced by HOST-side tooling/tests only. Deliberately NOT
# delivered to the n8n containers — nothing inside them reads it.
N8N_API_KEY=CHANGE_ME_N8N_API_KEY

# --- Webhook HMAC (shared by order-intake wf01 and support-triage wf03) ---
# Shared secret used to verify the inbound webhook HMAC signature.
#
# THIS IS THE ONE SECRET reachable from a Code node via $env, and it is reachable
# by necessity: n8n Code nodes cannot read credentials, so the Verify HMAC node
# has no other way to get it. Both webhook surfaces consume this SAME secret —
# two entry points, one secret. Everything else is delivered by file or withheld.
ORDER_INTAKE_HMAC_SECRET=CHANGE_ME_HMAC_SECRET

# --- Webhook Header Auth (both public webhook surfaces) ---
# Value of the authentication header n8n's Webhook node checks BEFORE it queues
# an execution. This is a different control from the HMAC signature and does a
# different job: this answers "who is calling", the HMAC answers "is this message
# authentic and untampered". They are complementary, not alternatives.
#
# One token per surface, so a compromised caller can be rotated or revoked
# without taking the other endpoint down with it.
#
# These are read HOST-side and imported as n8n CREDENTIALS; like the provider
# keys they are deliberately NOT delivered to the n8n containers' environment,
# so they never widen what a Code node can read.
ORDER_INTAKE_WEBHOOK_AUTH_TOKEN=CHANGE_ME_ORDER_INTAKE_WEBHOOK_AUTH_TOKEN
SUPPORT_TRIAGE_WEBHOOK_AUTH_TOKEN=CHANGE_ME_SUPPORT_TRIAGE_WEBHOOK_AUTH_TOKEN

# --- Workflow URLs are NOT set here ---
# The alert endpoint, the upstream API and the two CRM endpoints used to live in
# this file and reach the workflows through $env. They no longer do.
#
# Each workflow now carries its own configuration in a labelled `Workflow Config`
# node at its head, and the nodes that need a value reference that node. To
# re-point a workflow at a real endpoint, edit that one node in the workflow —
# not this file. See deployment/README.md, "exactly one $env reference in the
# whole workflow corpus", which is enforced by tests/env-corpus-surface.test.js.
#
# Nothing in this file is delivered to the n8n containers except the three
# variables in the allowlist in tools/materialise-secrets.mjs.

# --- AI support-triage workflow (wf03) ---
# Two DISTINCT provider chains. A fallback that calls the same provider as the
# primary is not a fallback — it fails for the same reason at the same moment.
# Both point at the in-stack mock provider here; in production each is a real,
# different vendor endpoint.
LLM_PRIMARY_BASE_URL=http://mock-llm:3001/primary/v1
LLM_FALLBACK_BASE_URL=http://mock-llm:3001/fallback/v1
# API keys for the two provider credentials. The mock ignores their value, but
# they are delivered by reference exactly as a real key would be, so nothing in
# the workflow has to change when a real endpoint is swapped in. These are read
# HOST-side and imported as n8n CREDENTIALS; they are deliberately NOT delivered
# to the n8n containers' environment.
LLM_PRIMARY_API_KEY=CHANGE_ME_LLM_PRIMARY_API_KEY
LLM_FALLBACK_API_KEY=CHANGE_ME_LLM_FALLBACK_API_KEY


# --- Observability: Prometheus metrics (n8n) ---
# Metrics are NOT an Enterprise-gated feature; log streaming is. This stack
# therefore demonstrates metrics and dashboards, which anyone can reproduce.
#
# These are CONTAINER-RUNTIME variables consumed by n8n itself. They are not
# `$env.X` references inside workflow JSON, so they do not widen the workflow
# corpus that tests/env-corpus-surface.test.js sweeps.
N8N_METRICS=true
# Bull queue metrics are gathered on the MAIN instance regardless of where
# executions run. Setting N8N_METRICS on the workers too adds worker process
# metrics; it is not what produces the queue metrics.
N8N_METRICS_INCLUDE_QUEUE_METRICS=true
# How often queue metrics are refreshed, in seconds.
N8N_METRICS_QUEUE_METRICS_INTERVAL=20

# --- Execution data retention ---
# Pruning is ON BY DEFAULT in n8n. Everything here is TUNING it, not enabling
# it — the values are set explicitly so the retention policy is visible in the
# configuration rather than inherited silently.
EXECUTIONS_DATA_PRUNE=true
# Age ceiling in HOURS. 168 = 7 days. The n8n default is 336 (14 days).
EXECUTIONS_DATA_MAX_AGE=168
# Count ceiling, applied alongside the age ceiling. n8n's default is 10000.
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000
# Safety buffer in HOURS before a soft-deleted execution is hard-deleted.
# Protects data somebody is actively debugging from vanishing mid-investigation.
EXECUTIONS_DATA_HARD_DELETE_BUFFER=1
#
# DELIBERATELY ABSENT: DB_SQLITE_VACUUM_ON_STARTUP. It is SQLite-only, and this
# stack runs Postgres in queue mode. Including it would be a visible correctness
# error to a reviewing engineer.

